                          "x": 0,
                          "y": 252,
                          "name": "After months of designing, building, and refining, Zuzuzoo was released ",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "After months of designing, building, and refining, Zuzuzoo was released on the App Store. Since launch, we've continued improving the experience, polishing the interface, and introducing new activities, with further development and expansion planned.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
