                          "id": "pJpXZ",
                          "x": 0,
                          "y": 0,
                          "name": "What started as a small personal project gradually evolved into a fully ",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "What started as a small personal project gradually evolved into a fully realized mobile app. Working closely with the developer, I refined the experience through multiple design iterations, explored new ideas, and adapted the interface as the product took shape.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
