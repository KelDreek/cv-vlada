                        {
                          "type": "text",
                          "id": "UtIet",
                          "x": 0,
                          "y": 0,
                          "name": "Over four years, I worked as the sole UX/UI designer on an established c",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "Over four years, I worked as the sole UX/UI designer on an established consumer app, taking over design responsibilities from the previous designer. As the product evolved, I designed increasingly complex features, improved existing experiences, developed the design system, and supported a major rebrand.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
