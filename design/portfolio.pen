                      "children": [
                        {
                          "type": "text",
                          "id": "Ge2qD",
                          "x": 0,
                          "y": 0,
                          "name": "Designing for toddlers meant rethinking familiar UI patterns. Text label",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "Designing for toddlers meant rethinking familiar UI patterns. Text labels, complex navigation, and small interactive elements weren't suitable for an audience still learning to read and navigate digital experiences.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "YVbDM",
                          "x": 0,
                          "y": 168,
                          "name": "​",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "​",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "aPK1B",
                          "x": 0,
                          "y": 196,
                          "name": "My early concepts followed more conventional app patterns, but through e",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "My early concepts followed more conventional app patterns, but through exploration and iteration, I gradually shifted toward a simpler, more playful approach.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "SXEwA",
                          "x": 0,
                          "y": 336,
                          "name": "​",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "​",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "MWi3q",
                          "x": 0,
                          "y": 364,
                          "name": "I replaced text-heavy interfaces with large illustrations, increased tou",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "I replaced text-heavy interfaces with large illustrations, increased touch target sizes, simplified navigation, and introduced a brighter visual language.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
