                      "fontFamily": "Averia Serif Libre",
                      "fontSize": 20,
                      "fontWeight": "300",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "JvsxF",
                      "x": 0,
                      "y": 140,
                      "name": "Over the past 7 years, I’ve designed mobile and web experiences across h",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": 640,
                      "content": "Over the past 7 years, I’ve designed mobile and web experiences across health & wellness, social platforms, SaaS, e-commerce, and consumer services. My work spans complex user flows, design systems, and close collaboration with developers through implementation and design QA.",
                      "lineHeight": 1.4,
                      "fontFamily": "Averia Serif Libre",
                      "fontSize": 20,
                      "fontWeight": "300",
                      "letterSpacing": -0.4
                    }
                  ]
