                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "Vx0oG",
                          "x": 0,
                          "y": 112,
                          "name": "My early concepts followed more conventional app patterns, but through e",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 640,
                          "content": "My early concepts followed more conventional app patterns, but through exploration and iteration, I gradually shifted toward a simpler, more playful approach.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
