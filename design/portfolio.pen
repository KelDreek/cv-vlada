                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "Sq5A6",
                          "x": 0,
                          "y": 308,
                          "name": "My work extended beyond mobile design to web experiences, an administrat",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "My work extended beyond mobile design to web experiences, an administration dashboard, and brand and marketing materials. I also introduced Design QA into the development workflow to help maintain implementation quality.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        }
                      ]
