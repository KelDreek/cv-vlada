                          "letterSpacing": -0.4
                        },
                        {
                          "type": "text",
                          "id": "i2y0f",
                          "x": 0,
                          "y": 504,
                          "name": "The goal was to make the experience understandable without requiring chi",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 343,
                          "content": "The goal was to make the experience understandable without requiring children to learn how to use the interface first.",
