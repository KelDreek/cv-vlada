                  "children": [
                    {
                      "type": "text",
                      "id": "AMukg",
                      "x": 0,
                      "y": 0,
                      "name": "I design digital products and enjoy creating clean interfaces that are e",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": 640,
                      "content": "I design digital products and enjoy creating clean interfaces that are easy to use. I like thinking through how things work and paying attention to the small details, sometimes spending a little too long getting an interaction to feel right.",
                      "lineHeight": 1.4,
                      "fontFamily": "Averia Serif Libre",
                      "fontSize": 20,
                      "fontWeight": "300",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "Tl5tf",
                      "x": 0,
