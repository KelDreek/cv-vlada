                        {
                          "type": "text",
                          "id": "AYO7j",
                          "x": 0,
                          "y": 0,
                          "name": "Designing for toddlers meant rethinking familiar UI patterns. Text label",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": 640,
                          "content": "Designing for toddlers meant rethinking familiar UI patterns. Text labels, complex navigation, and small interactive elements weren't suitable for an audience still learning to read and navigate digital experiences.",
                          "lineHeight": 1.4,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4
                        },
