                      "layout": "none",
                      "children": [
                        {
                          "type": "frame",
                          "id": "mirJn",
                          "x": 0,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:428",
                            "sourcePath": "1:888/1:330/1:331/1:418/1:427/1:428"
                          },
                          "width": 343,
                          "height": 572,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "rkPJ9",
                              "x": 0,
                              "y": 0,
                              "name": "Participating in Apple Entrepreneur Camp",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:429",
                                "sourcePath": "1:888/1:330/1:331/1:418/1:427/1:428/1:429"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 64,
                              "content": "Participating in Apple \nEntrepreneur Camp",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "OdBnv",
                              "x": 0,
                              "y": 96,
                              "name": "Another valuable experience was participating in Apple Entrepreneur Camp as part of the product team. Over approximately three months, we joined remote sessions with Apple representatives, presented our work, and received feedback and guidance. I contributed to preparing presentations and promotional materials and participated in the team's learning and feedback sessions. The program provided an opportunity to learn from Apple experts and bring new perspectives back into our work.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:430",
                                "sourcePath": "1:888/1:330/1:331/1:418/1:427/1:428/1:430"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 476,
                              "content": "Another valuable experience was \nparticipating in Apple Entrepreneur \nCamp as part of the product team.\n\nOver approximately three months, we \njoined remote sessions with Apple \nrepresentatives, presented our work, \nand received feedback and guidance.\n\nI contributed to preparing \npresentations and promotional \nmaterials and participated in the team's \nlearning and feedback sessions.\n\nThe program provided an opportunity \nto learn from Apple experts and bring \nnew perspectives back into our work.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
                        {
                          "id": "kKPUA",
