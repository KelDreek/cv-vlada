                              "layout": "none",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "NIVyp",
                                  "x": 0,
                                  "y": 0,
                                  "name": "Designing for young children showed me that simplicity isn't just about removing elements – it's about creating an experience around what users can understand and do.",
                                  "metadata": {
                                    "type": "figma-import",
                                    "nodeId": "1:764",
                                    "sourcePath": "1:889/1:673/1:674/1:753/1:760/1:761/1:763/1:764"
                                  },
                                  "fill": "$text-primary",
                                  "textGrowth": "fixed-width-height",
                                  "width": 311,
                                  "height": 256,
                                  "content": "Designing for young \nchildren showed me that \nsimplicity isn't just \nabout removing elements \n– it's about creating an \nexperience around what \nusers can understand \nand do.",
                                  "lineHeight": 1,
                                  "textAlign": "center",
                                  "fontFamily": "Averia Serif Libre",
                                  "fontSize": 32,
                                  "fontWeight": "700",
                                  "letterSpacing": -2,
                                  "fontStyle": "italic"
