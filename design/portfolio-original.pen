                            {
                              "type": "text",
                              "id": "a2Dkh",
                              "x": 0,
                              "y": 0,
                              "name": "Evolving the design system",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:287",
                                "sourcePath": "1:888/1:216/1:217/1:276/1:285/1:286/1:287"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Evolving the design system",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "xB0rZ",
                              "x": 0,
                              "y": 64,
                              "name": "The product already had a basic design system when I joined, but I substantially reworked and expanded it over time. I introduced more reusable components, improved the library's structure, and adopted new Figma capabilities to simplify design maintenance. The system became especially valuable during the rebrand, allowing changes to shared components to propagate across large numbers of screens. It also helped maintain consistency as new features and platforms continued to evolve.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:288",
                                "sourcePath": "1:888/1:216/1:217/1:276/1:285/1:286/1:288"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 336,
                              "content": "The product already had a basic design system when I joined, but I \nsubstantially reworked and expanded it over time.\n\nI introduced more reusable components, improved the library's structure, \nand adopted new Figma capabilities to simplify design maintenance.\n\nThe system became especially valuable during the rebrand, allowing \nchanges to shared components to propagate across large numbers of \nscreens.\n\nIt also helped maintain consistency as new features and platforms \ncontinued to evolve.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
