                        {
                          "type": "text",
                          "id": "jtjwm",
                          "x": 0,
                          "y": 172,
                          "name": "Zuzuzoo is an educational app for toddlers, featuring interactive animal games, sounds, and a playful encyclopedia. As the sole designer on a two-person team, I shaped the product from the ground up – from UX flows and visual identity to illustrations, animations, and final UI.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:584",
                            "sourcePath": "1:889/1:578/1:579/1:580/1:581/1:584"
