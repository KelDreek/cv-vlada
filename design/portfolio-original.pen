                          "children": [
                            {
                              "type": "text",
                              "id": "XlVSF",
                              "x": 0,
                              "y": 0,
                              "name": "Simplifying audio creation",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:251",
                                "sourcePath": "1:888/1:216/1:217/1:240/1:249/1:250/1:251"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Simplifying audio creation",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "nOLeR",
                              "x": 0,
                              "y": 64,
                              "name": "As new content formats were introduced, the original creation flow needed to evolve. Previously, the central Create action was dedicated to starting live conversations. With the introduction of recorded audio responses, users needed equally convenient access to other creation options. I proposed transforming the existing entry point into a unified creation menu with three clear paths: Answer a question: Select a submitted question and record an audio response. Create an audio post: Write a question or topic and record a response. Start a live conversation: Launch a live audio session. My goal was to make different creation actions feel like parts of one consistent experience rather than distributing them across the app.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:252",
                                "sourcePath": "1:888/1:216/1:217/1:240/1:249/1:250/1:252"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 476,
                              "content": "As new content formats were introduced, the original creation flow \nneeded to evolve.\n\nPreviously, the central Create action was dedicated to starting live \nconversations. With the introduction of recorded audio responses, users \nneeded equally convenient access to other creation options.\n\nI proposed transforming the existing entry point into a unified creation \nmenu with three clear paths:\n\nAnswer a question: Select a submitted question and record an audio \nresponse.\nCreate an audio post: Write a question or topic and record a response.\nStart a live conversation: Launch a live audio session.\n\nMy goal was to make different creation actions feel like parts of one \nconsistent experience rather than distributing them across the app.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
