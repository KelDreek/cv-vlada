                    },
                    {
                      "type": "frame",
                      "id": "fMt2k",
                      "x": 0,
                      "y": 942.375,
                      "name": "Frame 10",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:380",
                        "sourcePath": "1:888/1:330/1:331/1:374/1:380"
                      },
                      "width": 343,
                      "height": 974.375,
                      "layout": "none",
                      "children": [
                        {
                          "type": "frame",
                          "id": "XwJ6t",
                          "x": 0,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:381",
                            "sourcePath": "1:888/1:330/1:331/1:374/1:380/1:381"
                          },
                          "width": 343,
                          "height": 712,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "CbVFF",
                              "x": 0,
                              "y": 0,
                              "name": "Making daily activity the new focus",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:382",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:380/1:381/1:382"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 64,
                              "content": "Making daily activity the \nnew focus",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "B1oQr",
                              "x": 0,
                              "y": 96,
                              "name": "Step tracking became one of the app's primary features. I designed a new home screen displaying the user's daily step count, personal goal, and progress toward that goal. The feature used activity data from Apple Health and Health Connect, allowing users to follow their daily movement. I also worked on a social activity feature where users could add friends and see their step progress, creating opportunities for mutual encouragement. The main challenge was organizing these interconnected experiences into a clear home screen.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:383",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:380/1:381/1:383"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 616,
                              "content": "Step tracking became one of the app's \nprimary features.\n\nI designed a new home screen \ndisplaying the user's daily step count, \npersonal goal, and progress toward that \ngoal.\n\nThe feature used activity data from \nApple Health and Health Connect, \nallowing users to follow their daily \nmovement.\n\nI also worked on a social activity \nfeature where users could add friends \nand see their step progress, creating \nopportunities for mutual \nencouragement.\n\nThe main challenge was organizing \nthese interconnected experiences into a \nclear home screen.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
