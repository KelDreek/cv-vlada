                      "children": [
                        {
                          "type": "frame",
                          "id": "iv6qx",
                          "x": 0,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:409",
                            "sourcePath": "1:888/1:330/1:331/1:404/1:408/1:409"
                          },
                          "width": 343,
                          "height": 516,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "XGKqL",
                              "x": 0,
                              "y": 0,
                              "name": "Web experiences and administration tools",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:410",
                                "sourcePath": "1:888/1:330/1:331/1:404/1:408/1:409/1:410"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 64,
                              "content": "Web experiences and \nadministration tools",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "rib9F",
                              "x": 0,
                              "y": 96,
                              "name": "I maintained and expanded the platform's web administration dashboard, designing new functionality and updating existing interfaces as the product evolved. I also worked on web versions of selected app features, including live audio conversations, recorded responses, and user profiles. These experiences required adapting functionality and interface patterns to web environments while keeping them consistent with the wider product.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:411",
                                "sourcePath": "1:888/1:330/1:331/1:404/1:408/1:409/1:411"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 420,
                              "content": "I maintained and expanded the \nplatform's web administration \ndashboard, designing new functionality \nand updating existing interfaces as the \nproduct evolved.\n\nI also worked on web versions of \nselected app features, including live \naudio conversations, recorded \nresponses, and user profiles.\n\nThese experiences required adapting \nfunctionality and interface patterns to \nweb environments while keeping them \nconsistent with the wider product.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
