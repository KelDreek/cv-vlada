                      "children": [
                        {
                          "type": "text",
                          "id": "Wi3cv",
                          "x": 0,
                          "y": 0,
                          "name": "Taking Ownership Beyond Figma",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:306",
                            "sourcePath": "1:888/1:216/1:217/1:304/1:305/1:306"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 40,
                          "content": "Taking Ownership Beyond Figma",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "PnUNF",
                          "x": 0,
                          "y": 72,
                          "name": "Over time, my responsibilities grew beyond designing individual features. I became increasingly involved in how designs were implemented, reviewed, and maintained throughout development.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:307",
                            "sourcePath": "1:888/1:216/1:217/1:304/1:305/1:307"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 84,
                          "content": "Over time, my responsibilities grew beyond designing individual features. \nI became increasingly involved in how designs were implemented, \nreviewed, and maintained throughout development.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "R5h3V",
                      "x": 0,
                      "y": 236,
                      "name": "Frame 10",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:308",
                        "sourcePath": "1:888/1:216/1:217/1:304/1:308"
                      },
                      "width": 1024,
                      "height": 1396,
                      "layout": "none",
                      "children": [
                        {
                          "type": "frame",
                          "id": "L1sS1",
                          "x": 192,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:309",
                            "sourcePath": "1:888/1:216/1:217/1:304/1:308/1:309"
                          },
                          "width": 640,
                          "height": 708,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "A2QNT",
                              "x": 0,
                              "y": 0,
                              "name": "Introducing Design QA",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:310",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:308/1:309/1:310"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Introducing Design QA",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "bP5Sm",
                              "x": 0,
                              "y": 64,
                              "name": "Early in the project, I proposed introducing a dedicated Design QA stage to the team's workflow. The goal was to take direct responsibility for checking the quality of implemented interfaces while allowing QA engineers to focus more closely on functional testing. We established a process where developers shared screenshots, videos, and task details in a dedicated Slack channel after completing UI-related work. I reviewed the implementation, identified visual or interaction issues, and provided annotated feedback directly in discussion threads. Once I approved the design, the task could move forward to technical QA. This became a regular part of our development process, helping us address everything from small visual inconsistencies to larger issues involving animations and interaction behavior. The approach also attracted interest from colleagues on other projects, who asked me to demonstrate how our Design QA workflow was organized.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:311",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:308/1:309/1:311"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 644,
                              "content": "Early in the project, I proposed introducing a dedicated Design QA stage \nto the team's workflow.\n\nThe goal was to take direct responsibility for checking the quality of \nimplemented interfaces while allowing QA engineers to focus more \nclosely on functional testing.\n\nWe established a process where developers shared screenshots, videos, \nand task details in a dedicated Slack channel after completing UI-related \nwork.\n\nI reviewed the implementation, identified visual or interaction issues, and \nprovided annotated feedback directly in discussion threads.\n\nOnce I approved the design, the task could move forward to technical QA.\n\nThis became a regular part of our development process, helping us \naddress everything from small visual inconsistencies to larger issues \ninvolving animations and interaction behavior.\n\nThe approach also attracted interest from colleagues on other projects, \nwho asked me to demonstrate how our Design QA workflow was \norganized.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
                        {
                          "id": "mjczl",
                          "type": "ref",
                          "ref": "s37h6",
                          "name": "frame-image",
                          "x": 0,
