                                  "x": 192,
                                  "y": 326,
                                  "name": "Frame 1",
                                  "metadata": {
                                    "type": "figma-import",
                                    "nodeId": "1:325",
                                    "sourcePath": "1:888/1:216/1:217/1:304/1:318/1:322/1:323/1:325"
                                  },
                                  "width": 640,
                                  "height": 200,
                                  "layout": "none",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "MvsRP",
                                      "x": 0,
                                      "y": 0,
                                      "name": "The biggest lesson was that product design doesn't end with delivering screens – it also means taking responsibility for how the experience evolves and how it's brought to life.",
                                      "metadata": {
                                        "type": "figma-import",
                                        "nodeId": "1:326",
                                        "sourcePath": "1:888/1:216/1:217/1:304/1:318/1:322/1:323/1:325/1:326"
                                      },
                                      "fill": "$text-primary",
                                      "textGrowth": "fixed-width-height",
                                      "width": 640,
                                      "height": 200,
                                      "content": "The biggest lesson was that product \ndesign doesn't end with delivering \nscreens – it also means taking \nresponsibility for how the experience \nevolves and how it's brought to life.",
                                      "lineHeight": 1,
                                      "textAlign": "center",
                                      "fontFamily": "Averia Serif Libre",
                                      "fontSize": 40,
                                      "fontWeight": "700",
                                      "letterSpacing": -2.4000000953674316,
                                      "fontStyle": "italic"
                                    }
                                  ]
                                }
