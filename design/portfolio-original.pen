                      "children": [
                        {
                          "type": "text",
                          "id": "PyvVM",
                          "x": 0,
                          "y": 0,
                          "name": "From concept to launch",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:755",
                            "sourcePath": "1:889/1:673/1:674/1:753/1:754/1:755"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "From concept to \nlaunch",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "D2QniM",
                          "x": 0,
                          "y": 112,
                          "name": "What started as a small personal project gradually evolved into a fully realized mobile app. Working closely with the developer, I refined the experience through multiple design iterations, explored new ideas, and adapted the interface as the product took shape. After months of designing, building, and refining, Zuzuzoo was released on the App Store. Since launch, we've continued improving the experience, polishing the interface, and introducing new activities, with further development and expansion planned.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:756",
                            "sourcePath": "1:889/1:673/1:674/1:753/1:754/1:756"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 448,
                          "content": "What started as a small personal \nproject gradually evolved into a fully \nrealized mobile app. Working closely \nwith the developer, I refined the \nexperience through multiple design \niterations, explored new ideas, and \nadapted the interface as the product \ntook shape.\n\nAfter months of designing, building, \nand refining, Zuzuzoo was released on \nthe App Store. Since launch, we've \ncontinued improving the experience, \npolishing the interface, and \nintroducing new activities, with further \ndevelopment and expansion planned.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        },
