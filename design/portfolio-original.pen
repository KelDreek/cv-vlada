                        {
                          "type": "text",
                          "id": "Nmml1",
                          "x": 0,
                          "y": 80,
                          "name": "Vladislav Fidrik, UX/UI Designer based in Gdańsk, Poland",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:64",
                            "sourcePath": "1:887/1:59/1:60/1:61/1:62/1:64"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 64,
                          "content": "Vladislav Fidrik,\nUX/UI Designer based in Gdańsk, Poland",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 32,
                          "fontWeight": "700",
                          "letterSpacing": -2,
                          "fontStyle": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "PVmqY",
                      "x": 0,
                      "y": 176,
                      "name": "I design digital products and enjoy creating clean interfaces that are easy to use. I like thinking through how things work and paying attention to the small details, sometimes spending a little too long getting an interaction to feel right. Over the past 7 years, I’ve designed mobile and web experiences across health & wellness, social platforms, SaaS, e-commerce, and consumer services. My work spans complex user flows, design systems, and close collaboration with developers through implementation and design QA.",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:65",
                        "sourcePath": "1:887/1:59/1:60/1:61/1:65"
                      },
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width-height",
                      "width": 640,
                      "height": 252,
                      "content": "I design digital products and enjoy creating clean interfaces that are easy \nto use. I like thinking through how things work and paying attention to \nthe small details, sometimes spending a little too long getting an \ninteraction to feel right.\n\nOver the past 7 years, I’ve designed mobile and web experiences across \nhealth & wellness, social platforms, SaaS, e-commerce, and consumer \nservices. My work spans complex user flows, design systems, and close \ncollaboration with developers through implementation and design QA.",
                      "lineHeight": 1.399999976158142,
                      "fontFamily": "Averia Serif Libre",
                      "fontSize": 20,
                      "fontWeight": "300",
                      "letterSpacing": -0.4000000059604645
