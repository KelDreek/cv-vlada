                      "children": [
                        {
                          "type": "text",
                          "id": "B7P9s",
                          "x": 0,
                          "y": 0,
                          "name": "Designing for children who can't read yet",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:603",
                            "sourcePath": "1:889/1:578/1:579/1:601/1:602/1:603"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 40,
                          "content": "Designing for children who can't read yet",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "aSmXy",
                          "x": 0,
                          "y": 72,
                          "name": "Designing for toddlers meant rethinking familiar UI patterns. Text labels, complex navigation, and small interactive elements weren't suitable for an audience still learning to read and navigate digital experiences. My early concepts followed more conventional app patterns, but through exploration and iteration, I gradually shifted toward a simpler, more playful approach. I replaced text-heavy interfaces with large illustrations, increased touch target sizes, simplified navigation, and introduced a brighter visual language. The goal was to make the experience understandable without requiring children to learn how to use the interface first. The goal was to make the experience understandable without requiring children to learn how to use the interface first.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:604",
                            "sourcePath": "1:889/1:578/1:579/1:601/1:602/1:604"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 476,
                          "content": "Designing for toddlers meant rethinking familiar UI patterns. Text labels, \ncomplex navigation, and small interactive elements weren't suitable for \nan audience still learning to read and navigate digital experiences.\n\nMy early concepts followed more conventional app patterns, but through \nexploration and iteration, I gradually shifted toward a simpler, more \nplayful approach.\n\nI replaced text-heavy interfaces with large illustrations, increased touch \ntarget sizes, simplified navigation, and introduced a brighter visual \nlanguage.\n\nThe goal was to make the experience understandable without requiring \nchildren to learn how to use the interface first.\n\nThe goal was to make the experience understandable without requiring \nchildren to learn how to use the interface first.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
