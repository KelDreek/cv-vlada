                        {
                          "type": "text",
                          "id": "EuPyU",
                          "x": 0,
                          "y": 60,
                          "name": "Designing the Evolution of a Consumer App: From Social Audio to Wellness",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:221",
                            "sourcePath": "1:888/1:216/1:217/1:218/1:219/1:221"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 80,
                          "content": "Designing the Evolution of a Consumer \nApp: From Social Audio to Wellness",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "zrThG",
                          "x": 0,
                          "y": 172,
                          "name": "Over four years, I worked as the sole UX/UI designer on an established consumer app, taking over design responsibilities from the previous designer. As the product evolved, I designed increasingly complex features, improved existing experiences, developed the design system, and supported a major rebrand. My work extended beyond mobile design to web experiences, an administration dashboard, and brand and marketing materials. I also introduced Design QA into the development workflow to help maintain implementation quality.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:222",
                            "sourcePath": "1:888/1:216/1:217/1:218/1:219/1:222"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 280,
                          "content": "Over four years, I worked as the sole UX/UI designer on an established \nconsumer app, taking over design responsibilities from the previous \ndesigner. As the product evolved, I designed increasingly complex \nfeatures, improved existing experiences, developed the design system, \nand supported a major rebrand.\n\nMy work extended beyond mobile design to web experiences, an \nadministration dashboard, and brand and marketing materials. I also \nintroduced Design QA into the development workflow to help maintain \nimplementation quality.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        },
