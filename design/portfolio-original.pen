                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "JAvpN",
                          "x": 0,
                          "y": 72,
                          "name": "Initially, the platform focused on social audio, allowing users to create and discover recordings, engage with creators, participate in live conversations, and connect with people who shared similar interests. As new features were introduced, my focus was on integrating them into the existing experience without making navigation unnecessarily complex.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:243",
                            "sourcePath": "1:888/1:216/1:217/1:240/1:241/1:243"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 196,
                          "content": "Initially, the platform focused on social audio, allowing users to create \nand discover recordings, engage with creators, participate in live \nconversations, and connect with people who shared similar interests.\n\nAs new features were introduced, my focus was on integrating them into \nthe existing experience without making navigation unnecessarily \ncomplex.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
