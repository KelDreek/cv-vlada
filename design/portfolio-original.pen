                          "url": "original-assets/a2e50091488e15f8fa7e61ec6cf86eb4b397b694.png",
                          "mode": "cover"
                        }
                      ],
                      "cornerRadius": 16,
                      "layout": "none",
                      "clip": true
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "pcL32",
                  "x": 0,
                  "y": 5305.5,
                  "name": "Frame 19",
                  "metadata": {
                    "type": "figma-import",
                    "nodeId": "1:739",
                    "sourcePath": "1:889/1:673/1:674/1:739"
                  },
                  "width": 343,
                  "height": 990.375,
                  "layout": "none",
                  "children": [
                    {
                      "type": "frame",
                      "id": "o0HqBr",
                      "x": 0,
                      "y": 0,
                      "name": "bio",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:740",
                        "sourcePath": "1:889/1:673/1:674/1:739/1:740"
                      },
                      "width": 343,
                      "height": 728,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "A8XM3",
                          "x": 0,
                          "y": 0,
                          "name": "A playful world built from scratch",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:741",
                            "sourcePath": "1:889/1:673/1:674/1:739/1:740/1:741"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "A playful world built \nfrom scratch",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "bcZrc",
                          "x": 0,
                          "y": 112,
                          "name": "With no existing brand or visual system, I created Zuzuzoo's visual identity from the ground up. The direction focused on warmth, simplicity, and playful character – combining friendly animal illustrations, bright colors, soft shapes, and large interactive elements. Illustrations became an essential part of the visual language, helping children recognize activities and making the experience feel more engaging and approachable. I also developed a lightweight design system to maintain consistency across iPhone, iPad, the new foldable iPhone Duo, and Android devices, keeping components and interaction patterns intentionally simple.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:742",
                            "sourcePath": "1:889/1:673/1:674/1:739/1:740/1:742"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 616,
                          "content": "With no existing brand or visual \nsystem, I created Zuzuzoo's visual \nidentity from the ground up.\n\nThe direction focused on warmth, \nsimplicity, and playful character – \ncombining friendly animal \nillustrations, bright colors, soft shapes, \nand large interactive elements.\n\nIllustrations became an essential part \nof the visual language, helping children \nrecognize activities and making the \nexperience feel more engaging and \napproachable.\n\nI also developed a lightweight design \nsystem to maintain consistency across \niPhone, iPad, the new foldable iPhone \nDuo, and Android devices, keeping \ncomponents and interaction patterns \nintentionally simple.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
                    {
                      "id": "v2IEgp",
