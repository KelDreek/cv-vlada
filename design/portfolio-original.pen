                      "layout": "none",
                      "children": [
                        {
                          "type": "frame",
                          "id": "jNucM",
                          "x": 0,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:414",
                            "sourcePath": "1:888/1:330/1:331/1:404/1:413/1:414"
                          },
                          "width": 343,
                          "height": 736,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "TfPKB",
                              "x": 0,
                              "y": 0,
                              "name": "Branding and marketing",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:415",
                                "sourcePath": "1:888/1:330/1:331/1:404/1:413/1:414/1:415"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 32,
                              "content": "Branding and marketing",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "OW6Ft",
                              "x": 0,
                              "y": 64,
                              "name": "Alongside product design, I created and maintained a range of brand and promotional materials. My responsibilities included updating logos and app icons, preparing App Store and Google Play screenshots, maintaining the product website, and designing promotional graphics and banners. One of the highlights was when the app was selected as Apple's App of the Day and featured on the App Store's main page. I was responsible for preparing the promotional artwork for the feature, following Apple's design guidelines and requirements. During the rebrand, I also helped apply the updated visual identity across different touchpoints, maintaining a consistent brand experience beyond the app itself.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:416",
                                "sourcePath": "1:888/1:330/1:331/1:404/1:413/1:414/1:416"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 672,
                              "content": "Alongside product design, I created and \nmaintained a range of brand and \npromotional materials.\n\nMy responsibilities included updating \nlogos and app icons, preparing App \nStore and Google Play screenshots, \nmaintaining the product website, and \ndesigning promotional graphics and \nbanners.\n\nOne of the highlights was when the app \nwas selected as Apple's App of the Day \nand featured on the App Store's main \npage. I was responsible for preparing \nthe promotional artwork for the \nfeature, following Apple's design \nguidelines and requirements.\n\nDuring the rebrand, I also helped apply \nthe updated visual identity across \ndifferent touchpoints, maintaining a \nconsistent brand experience beyond \nthe app itself.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
