                        {
                          "type": "text",
                          "id": "kaPS9",
                          "x": 0,
                          "y": 0,
                          "name": "Designing Social Audio Experiences",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:242",
                            "sourcePath": "1:888/1:216/1:217/1:240/1:241/1:242"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 40,
                          "content": "Designing Social Audio Experiences",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
