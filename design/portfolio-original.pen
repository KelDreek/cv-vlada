                          "x": 0,
                          "y": 0,
                          "name": "Designing Social Audio Experiences",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:356",
                            "sourcePath": "1:888/1:330/1:331/1:354/1:355/1:356"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "Designing Social \nAudio Experiences",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "j9C8T",
                          "x": 0,
                          "y": 112,
                          "name": "Initially, the platform focused on social audio, allowing users to create and discover recordings, engage with creators, participate in live conversations, and connect with people who shared similar interests. As new features were introduced, my focus was on integrating them into the existing experience without making navigation unnecessarily complex.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:357",
                            "sourcePath": "1:888/1:330/1:331/1:354/1:355/1:357"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 308,
                          "content": "Initially, the platform focused on social \naudio, allowing users to create and \ndiscover recordings, engage with \ncreators, participate in live \nconversations, and connect with people \nwho shared similar interests.\n\nAs new features were introduced, my \nfocus was on integrating them into the \nexisting experience without making \nnavigation unnecessarily complex.",
