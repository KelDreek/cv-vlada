                          "height": 64
                        },
                        {
                          "type": "text",
                          "id": "tFj75",
                          "x": 0,
                          "y": 80,
                          "name": "Vladislav Fidrik, UX/UI Designer based in Gdańsk, Poland",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:85",
                            "sourcePath": "1:887/1:80/1:81/1:82/1:83/1:85"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 367,
                          "height": 96,
                          "content": "Vladislav Fidrik,\nUX/UI Designer based in \nGdańsk, Poland",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 32,
                          "fontWeight": "700",
                          "letterSpacing": -2,
                          "fontStyle": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "lLMPn",
                      "x": 0,
                      "y": 208,
                      "name": "I design digital products and enjoy creating clean interfaces that are easy to use. I like thinking through how things work and paying attention to the small details, sometimes spending a little too long getting an interaction to feel right. Over the past 7 years, I’ve designed mobile and web experiences across health & wellness, social platforms, SaaS, e-commerce, and consumer services. My work spans complex user flows, design systems, and close collaboration with developers through implementation and design QA.",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:86",
                        "sourcePath": "1:887/1:80/1:81/1:82/1:86"
                      },
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width-height",
                      "width": 367,
                      "height": 420,
                      "content": "I design digital products and enjoy \ncreating clean interfaces that are easy to \nuse. I like thinking through how things \nwork and paying attention to the small \ndetails, sometimes spending a little too \nlong getting an interaction to feel right.\n\nOver the past 7 years, I’ve designed \nmobile and web experiences across health \n& wellness, social platforms, SaaS, e-\ncommerce, and consumer services. My \nwork spans complex user flows, design \nsystems, and close collaboration with \ndevelopers through implementation and \ndesign QA.",
                      "lineHeight": 1.399999976158142,
                      "fontFamily": "Averia Serif Libre",
                      "fontSize": 20,
                      "fontWeight": "300",
                      "letterSpacing": -0.4000000059604645
                    },
