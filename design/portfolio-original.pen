                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "HaxcA",
                          "x": 0,
                          "y": 0,
                          "name": "Inside Zuzuzoo",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:746",
                            "sourcePath": "1:889/1:673/1:674/1:744/1:745/1:746"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 40,
                          "content": "Inside Zuzuzoo",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "fFscz",
                          "x": 0,
                          "y": 72,
                          "name": "Zuzuzoo brings together eight playful, interactive mini-games designed to help young children discover animals through sounds, visual challenges, and simple questions. Each activity follows clear, familiar interaction patterns, allowing children to focus on playing, exploring, and learning rather than figuring out how the interface works. Beyond the games, the app features an animal encyclopedia with sounds and simple facts, as well as a dedicated parent area for managing subscriptions, language preferences, and settings.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:747",
                            "sourcePath": "1:889/1:673/1:674/1:744/1:745/1:747"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 504,
                          "content": "Zuzuzoo brings together eight playful, \ninteractive mini-games designed to \nhelp young children discover animals \nthrough sounds, visual challenges, and \nsimple questions.\n\nEach activity follows clear, familiar \ninteraction patterns, allowing children \nto focus on playing, exploring, and \nlearning rather than figuring out how \nthe interface works.\n\nBeyond the games, the app features an \nanimal encyclopedia with sounds and \nsimple facts, as well as a dedicated \nparent area for managing \nsubscriptions, language preferences, \nand settings.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
