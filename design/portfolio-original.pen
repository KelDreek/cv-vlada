                      "children": [
                        {
                          "type": "text",
                          "id": "A3jlnx",
                          "x": 0,
                          "y": 0,
                          "name": "From concept to launch",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:660",
                            "sourcePath": "1:889/1:578/1:579/1:658/1:659/1:660"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 40,
                          "content": "From concept to launch",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "sCTZq",
                          "x": 0,
                          "y": 72,
                          "name": "What started as a small personal project gradually evolved into a fully realized mobile app. Working closely with the developer, I refined the experience through multiple design iterations, explored new ideas, and adapted the interface as the product took shape. After months of designing, building, and refining, Zuzuzoo was released on the App Store. Since launch, we've continued improving the experience, polishing the interface, and introducing new activities, with further development and expansion planned.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:661",
                            "sourcePath": "1:889/1:578/1:579/1:658/1:659/1:661"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 252,
                          "content": "What started as a small personal project gradually evolved into a fully \nrealized mobile app. Working closely with the developer, I refined the \nexperience through multiple design iterations, explored new ideas, and \nadapted the interface as the product took shape.\n\nAfter months of designing, building, and refining, Zuzuzoo was released \non the App Store. Since launch, we've continued improving the \nexperience, polishing the interface, and introducing new activities, with \nfurther development and expansion planned.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        },
