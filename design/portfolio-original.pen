                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:376",
                            "sourcePath": "1:888/1:330/1:331/1:374/1:375/1:376"
                          },
                          "width": 343,
                          "height": 600,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "Ig6Kh",
                              "x": 0,
                              "y": 0,
                              "name": "A New Direction: Everyday Wellness Takes Center Stage",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:377",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:375/1:376/1:377"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 120,
                              "content": "A New Direction: \nEveryday Wellness \nTakes Center Stage",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 40,
                              "fontWeight": "700",
                              "letterSpacing": -2.4000000953674316,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "N2kmo",
                              "x": 0,
                              "y": 152,
                              "name": "Following a change in the client's business direction, the product underwent a major rebrand and began shifting from social audio toward health and wellness. This introduced new primary user journeys, including step tracking and daily habits, while existing social features gradually moved into the background. My challenge was to integrate these new experiences into an established product and adapt its navigation to reflect the changing priorities.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:378",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:375/1:376/1:378"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 448,
                              "content": "Following a change in the client's \nbusiness direction, the product \nunderwent a major rebrand and began \nshifting from social audio toward \nhealth and wellness.\n\nThis introduced new primary user \njourneys, including step tracking and \ndaily habits, while existing social \nfeatures gradually moved into the \nbackground.\n\nMy challenge was to integrate these \nnew experiences into an established \nproduct and adapt its navigation to \nreflect the changing priorities.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
