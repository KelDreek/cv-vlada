                          "width": 343,
                          "height": 516,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "SK1gu",
                              "x": 0,
                              "y": 0,
                              "name": "Applying the new visual direction",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:396",
                                "sourcePath": "1:888/1:330/1:331/1:390/1:394/1:395/1:396"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 64,
                              "content": "Applying the new visual \ndirection",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "yRpWd",
                              "x": 0,
                              "y": 96,
                              "name": "The biggest challenge was applying the updated visual direction consistently across hundreds of existing designs while product development continued. I used the component library to update shared styles, colors, and UI elements across the application, then reviewed and refined individual screens according to their priority and requirements. This helped make a large-scale update more manageable without redesigning every screen from scratch.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:397",
                                "sourcePath": "1:888/1:330/1:331/1:390/1:394/1:395/1:397"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 420,
                              "content": "The biggest challenge was applying the \nupdated visual direction consistently \nacross hundreds of existing designs \nwhile product development continued.\n\nI used the component library to update \nshared styles, colors, and UI elements \nacross the application, then reviewed \nand refined individual screens \naccording to their priority and \nrequirements.\n\nThis helped make a large-scale update \nmore manageable without redesigning \nevery screen from scratch.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
