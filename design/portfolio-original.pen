                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "hVLyg",
                              "x": 0,
                              "y": 0,
                              "name": "Branding and marketing",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:301",
                                "sourcePath": "1:888/1:216/1:217/1:290/1:299/1:300/1:301"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Branding and marketing",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "fxdrx",
                              "x": 0,
                              "y": 64,
                              "name": "Alongside product design, I created and maintained a range of brand and promotional materials. My responsibilities included updating logos and app icons, preparing App Store and Google Play screenshots, maintaining the product website, and designing promotional graphics and banners. One of the highlights was when the app was selected as Apple's App of the Day and featured on the App Store's main page. I was responsible for preparing the promotional artwork for the feature, following Apple's design guidelines and requirements. During the rebrand, I also helped apply the updated visual identity across different touchpoints, maintaining a consistent brand experience beyond the app itself.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:302",
                                "sourcePath": "1:888/1:216/1:217/1:290/1:299/1:300/1:302"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 420,
                              "content": "Alongside product design, I created and maintained a range of brand and \npromotional materials.\n\nMy responsibilities included updating logos and app icons, preparing App \nStore and Google Play screenshots, maintaining the product website, and \ndesigning promotional graphics and banners.\n\nOne of the highlights was when the app was selected as Apple's App of \nthe Day and featured on the App Store's main page. I was responsible for \npreparing the promotional artwork for the feature, following Apple's \ndesign guidelines and requirements.\n\nDuring the rebrand, I also helped apply the updated visual identity across \ndifferent touchpoints, maintaining a consistent brand experience beyond \nthe app itself.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
