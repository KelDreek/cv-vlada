                      "height": 380,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "t1Glj",
                          "x": 0,
                          "y": 0,
                          "name": "Inside Zuzuzoo",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:651",
                            "sourcePath": "1:889/1:578/1:579/1:649/1:650/1:651"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 40,
                          "content": "Inside Zuzuzoo",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "Q5rpjs",
                          "x": 0,
                          "y": 72,
                          "name": "Zuzuzoo brings together eight playful, interactive mini-games designed to help young children discover animals through sounds, visual challenges, and simple questions. Each activity follows clear, familiar interaction patterns, allowing children to focus on playing, exploring, and learning rather than figuring out how the interface works. Beyond the games, the app features an animal encyclopedia with sounds and simple facts, as well as a dedicated parent area for managing subscriptions, language preferences, and settings.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:652",
                            "sourcePath": "1:889/1:578/1:579/1:649/1:650/1:652"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 308,
                          "content": "Zuzuzoo brings together eight playful, interactive mini-games designed to \nhelp young children discover animals through sounds, visual challenges, \nand simple questions.\n\nEach activity follows clear, familiar interaction patterns, allowing \nchildren to focus on playing, exploring, and learning rather than figuring \nout how the interface works.\n\nBeyond the games, the app features an animal encyclopedia with sounds \nand simple facts, as well as a dedicated parent area for managing \nsubscriptions, language preferences, and settings.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
