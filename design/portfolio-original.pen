                          "width": 640,
                          "height": 484,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "R8KS1z",
                              "x": 0,
                              "y": 0,
                              "name": "Making healthy habits easy to track",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:273",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:271/1:272/1:273"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Making healthy habits easy to track",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "L4Oh8h",
                              "x": 0,
                              "y": 64,
                              "name": "Alongside step tracking, I designed a dedicated experience for managing everyday wellness habits. Users could start with a default set of habits or build a personalized routine by choosing from a larger library organized into categories. Most habits followed a simple tap-to-complete interaction, while some activities involved additional steps, such as watching a workout video. I focused on keeping the experience clean and straightforward, allowing users to manage different types of habits through familiar interaction patterns. I also contributed to other wellness functionality, including mood tracking, as the product continued to develop.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:274",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:271/1:272/1:274"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 420,
                              "content": "Alongside step tracking, I designed a dedicated experience for managing \neveryday wellness habits.\n\nUsers could start with a default set of habits or build a personalized \nroutine by choosing from a larger library organized into categories.\n\nMost habits followed a simple tap-to-complete interaction, while some \nactivities involved additional steps, such as watching a workout video.\n\nI focused on keeping the experience clean and straightforward, allowing \nusers to manage different types of habits through familiar interaction \npatterns.\n\nI also contributed to other wellness functionality, including mood \ntracking, as the product continued to develop.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
