                          "width": 640,
                          "height": 624,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "DsjOF",
                              "x": 0,
                              "y": 0,
                              "name": "Connecting people through shared interests",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:256",
                                "sourcePath": "1:888/1:216/1:217/1:240/1:254/1:255/1:256"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Connecting people through shared interests",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "JHvcG",
                              "x": 0,
                              "y": 64,
                              "name": "Another major feature I designed helped users discover people with similar interests, opinions, and perspectives. The experience consisted of two connected parts. First, users answered a collection of yes-or-no questions across different topics, gradually building a profile of their views. Based on shared answers, the app recommended other users through swipeable profile cards, highlighting what they had in common. Users could express interest or move on. When two people expressed mutual interest, they could connect through a chat. I designed the end-to-end experience, including user flows, interaction details, and animations, while collaborating with developers on the implementation. I also proposed a short voice introduction feature inspired by social media Stories, allowing users to record personal greetings displayed through a ring around their profile picture.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:257",
                                "sourcePath": "1:888/1:216/1:217/1:240/1:254/1:255/1:257"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 560,
                              "content": "Another major feature I designed helped users discover people with \nsimilar interests, opinions, and perspectives.\n\nThe experience consisted of two connected parts. First, users answered a \ncollection of yes-or-no questions across different topics, gradually \nbuilding a profile of their views.\n\nBased on shared answers, the app recommended other users through \nswipeable profile cards, highlighting what they had in common.\n\nUsers could express interest or move on. When two people expressed \nmutual interest, they could connect through a chat.\n\nI designed the end-to-end experience, including user flows, interaction \ndetails, and animations, while collaborating with developers on the \nimplementation.\n\nI also proposed a short voice introduction feature inspired by social media \nStories, allowing users to record personal greetings displayed through a \nring around their profile picture.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
