                          "x": 0,
                          "y": 72,
                          "name": "One of my key UX decisions was replacing written instructions with voice guidance. Instead of relying on text, Zuzuzoo uses a friendly voice to introduce games, ask questions, and provide feedback on children's actions. Each interaction has multiple voice variations with different wording and intonation, making the experience feel more natural and less repetitive. Voice guidance is available in 10 languages, allowing children to explore the app in their family's preferred language. By moving instructions from text to audio, I could simplify the interface while keeping children guided throughout the experience.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:612",
                            "sourcePath": "1:889/1:578/1:579/1:609/1:610/1:612"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 640,
                          "height": 392,
                          "content": "One of my key UX decisions was replacing written instructions with voice \nguidance.\n\nInstead of relying on text, Zuzuzoo uses a friendly voice to introduce \ngames, ask questions, and provide feedback on children's actions.\n\nEach interaction has multiple voice variations with different wording and \nintonation, making the experience feel more natural and less repetitive.\n\nVoice guidance is available in 10 languages, allowing children to explore \nthe app in their family's preferred language.\n\nBy moving instructions from text to audio, I could simplify the interface \nwhile keeping children guided throughout the experience.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
