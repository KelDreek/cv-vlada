                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:386",
                            "sourcePath": "1:888/1:330/1:331/1:374/1:385/1:386"
                          },
                          "width": 343,
                          "height": 740,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "PFFvd",
                              "x": 0,
                              "y": 0,
                              "name": "Making healthy habits easy to track",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:387",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:385/1:386/1:387"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 64,
                              "content": "Making healthy habits easy \nto track",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "m19Lw",
                              "x": 0,
                              "y": 96,
                              "name": "Alongside step tracking, I designed a dedicated experience for managing everyday wellness habits. Users could start with a default set of habits or build a personalized routine by choosing from a larger library organized into categories. Most habits followed a simple tap-to-complete interaction, while some activities involved additional steps, such as watching a workout video. I focused on keeping the experience clean and straightforward, allowing users to manage different types of habits through familiar interaction patterns. I also contributed to other wellness functionality, including mood tracking, as the product continued to develop.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:388",
                                "sourcePath": "1:888/1:330/1:331/1:374/1:385/1:386/1:388"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 644,
                              "content": "Alongside step tracking, I designed a \ndedicated experience for managing \neveryday wellness habits.\n\nUsers could start with a default set of \nhabits or build a personalized routine \nby choosing from a larger library \norganized into categories.\n\nMost habits followed a simple tap-to-\ncomplete interaction, while some \nactivities involved additional steps, \nsuch as watching a workout video.\n\nI focused on keeping the experience \nclean and straightforward, allowing \nusers to manage different types of \nhabits through familiar interaction \npatterns.\n\nI also contributed to other wellness \nfunctionality, including mood tracking, \nas the product continued to develop.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
