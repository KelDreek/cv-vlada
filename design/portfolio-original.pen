                  "children": [
                    {
                      "type": "frame",
                      "id": "W6Mkoy",
                      "x": 0,
                      "y": 0,
                      "name": "bio",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:705",
                        "sourcePath": "1:889/1:673/1:674/1:704/1:705"
                      },
                      "width": 343,
                      "height": 756,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "JPfHB",
                          "x": 0,
                          "y": 0,
                          "name": "Let the app speak for itself",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:706",
                            "sourcePath": "1:889/1:673/1:674/1:704/1:705/1:706"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "Let the app speak for \nitself",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "e5CUf",
                          "x": 0,
                          "y": 112,
                          "name": "One of my key UX decisions was replacing written instructions with voice guidance. Instead of relying on text, Zuzuzoo uses a friendly voice to introduce games, ask questions, and provide feedback on children's actions. Each interaction has multiple voice variations with different wording and intonation, making the experience feel more natural and less repetitive. Voice guidance is available in 10 languages, allowing children to explore the app in their family's preferred language. By moving instructions from text to audio, I could simplify the interface while keeping children guided throughout the experience.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:707",
                            "sourcePath": "1:889/1:673/1:674/1:704/1:705/1:707"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 644,
                          "content": "One of my key UX decisions was \nreplacing written instructions with \nvoice guidance.\n\nInstead of relying on text, Zuzuzoo uses \na friendly voice to introduce games, ask \nquestions, and provide feedback on \nchildren's actions.\n\nEach interaction has multiple voice \nvariations with different wording and \nintonation, making the experience feel \nmore natural and less repetitive.\n\nVoice guidance is available in 10 \nlanguages, allowing children to explore \nthe app in their family's preferred \nlanguage.\n\nBy moving instructions from text to \naudio, I could simplify the interface \nwhile keeping children guided \nthroughout the experience.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
