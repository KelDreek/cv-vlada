                          "width": 640,
                          "height": 392,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "fRUJK",
                              "x": 0,
                              "y": 0,
                              "name": "A New Direction: Everyday Wellness Takes Center Stage",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:263",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:261/1:262/1:263"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 80,
                              "content": "A New Direction: Everyday Wellness \nTakes Center Stage",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 40,
                              "fontWeight": "700",
                              "letterSpacing": -2.4000000953674316,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "koMs2",
                              "x": 0,
                              "y": 112,
                              "name": "Following a change in the client's business direction, the product underwent a major rebrand and began shifting from social audio toward health and wellness. This introduced new primary user journeys, including step tracking and daily habits, while existing social features gradually moved into the background. My challenge was to integrate these new experiences into an established product and adapt its navigation to reflect the changing priorities.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:264",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:261/1:262/1:264"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 280,
                              "content": "Following a change in the client's business direction, the product \nunderwent a major rebrand and began shifting from social audio toward \nhealth and wellness.\n\nThis introduced new primary user journeys, including step tracking and \ndaily habits, while existing social features gradually moved into the \nbackground.\n\nMy challenge was to integrate these new experiences into an established \nproduct and adapt its navigation to reflect the changing priorities.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
