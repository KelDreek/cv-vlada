                                  "width": 215,
                                  "height": 180
                                },
                                {
                                  "type": "frame",
                                  "id": "Gej7D",
                                  "x": 16,
                                  "y": 282,
                                  "name": "Frame 1",
                                  "metadata": {
                                    "type": "figma-import",
                                    "nodeId": "1:439",
                                    "sourcePath": "1:888/1:330/1:331/1:418/1:432/1:436/1:437/1:439"
                                  },
                                  "width": 311,
                                  "height": 288,
                                  "layout": "none",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "OUp0t",
                                      "x": 0,
                                      "y": 0,
                                      "name": "The biggest lesson was that product design doesn't end with delivering screens – it also means taking responsibility for how the experience evolves and how it's brought to life.",
                                      "metadata": {
                                        "type": "figma-import",
                                        "nodeId": "1:440",
                                        "sourcePath": "1:888/1:330/1:331/1:418/1:432/1:436/1:437/1:439/1:440"
                                      },
                                      "fill": "$text-primary",
                                      "textGrowth": "fixed-width-height",
                                      "width": 311,
                                      "height": 288,
                                      "content": "The biggest lesson was \nthat product design \ndoesn't end with \ndelivering screens – it \nalso means taking \nresponsibility for how \nthe experience evolves \nand how it's brought to \nlife.",
                                      "lineHeight": 1,
                                      "textAlign": "center",
                                      "fontFamily": "Averia Serif Libre",
                                      "fontSize": 32,
                                      "fontWeight": "700",
                                      "letterSpacing": -2,
                                      "fontStyle": "italic"
                                    }
                                  ]
                                }
                              ]
                            },
