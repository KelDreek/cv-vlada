                    },
                    {
                      "type": "frame",
                      "id": "Yb9kn",
                      "x": 0,
                      "y": 2852,
                      "name": "Frame 12",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:318",
                        "sourcePath": "1:888/1:216/1:217/1:304/1:318"
                      },
                      "width": 1024,
