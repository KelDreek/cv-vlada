                          "children": [
                            {
                              "type": "text",
                              "id": "jZfdz",
                              "x": 0,
                              "y": 0,
                              "name": "Evolving the design system",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:401",
                                "sourcePath": "1:888/1:330/1:331/1:390/1:399/1:400/1:401"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 32,
                              "content": "Evolving the design system",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "uyERx",
                              "x": 0,
                              "y": 64,
                              "name": "The product already had a basic design system when I joined, but I substantially reworked and expanded it over time. I introduced more reusable components, improved the library's structure, and adopted new Figma capabilities to simplify design maintenance. The system became especially valuable during the rebrand, allowing changes to shared components to propagate across large numbers of screens. It also helped maintain consistency as new features and platforms continued to evolve.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:402",
                                "sourcePath": "1:888/1:330/1:331/1:390/1:399/1:400/1:402"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 532,
                              "content": "The product already had a basic design \nsystem when I joined, but I \nsubstantially reworked and expanded it \nover time.\n\nI introduced more reusable \ncomponents, improved the library's \nstructure, and adopted new Figma \ncapabilities to simplify design \nmaintenance.\n\nThe system became especially valuable \nduring the rebrand, allowing changes \nto shared components to propagate \nacross large numbers of screens.\n\nIt also helped maintain consistency as \nnew features and platforms continued \nto evolve.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
