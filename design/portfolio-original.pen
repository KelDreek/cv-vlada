                  "children": [
                    {
                      "type": "frame",
                      "id": "QnfgV",
                      "x": 0,
                      "y": 0,
                      "name": "bio",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:735",
                        "sourcePath": "1:889/1:673/1:674/1:734/1:735"
                      },
                      "width": 343,
                      "height": 728,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "f08wh",
                          "x": 0,
                          "y": 0,
                          "name": "Less navigation, more playing",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:736",
                            "sourcePath": "1:889/1:673/1:674/1:734/1:735/1:736"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "Less navigation, more \nplaying",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "RDDU8",
                          "x": 0,
                          "y": 112,
                          "name": "Another important decision was simplifying how children move between activities. Instead of relying on traditional navigation, I designed the game menu as a central hub connecting the entire experience. Each game consists of five short rounds. After completing them, children automatically return to the hub, where a friendly voice invites them to choose another activity. They can also leave a game early or replay it. This repeatable loop reduces unnecessary navigation decisions and makes moving between games feel natural.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:737",
                            "sourcePath": "1:889/1:673/1:674/1:734/1:735/1:737"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 616,
                          "content": "Another important decision was \nsimplifying how children move \nbetween activities.\n\nInstead of relying on traditional \nnavigation, I designed the game menu \nas a central hub connecting the entire \nexperience.\n\nEach game consists of five short \nrounds. After completing them, \nchildren automatically return to the \nhub, where a friendly voice invites \nthem to choose another activity.\n\nThey can also leave a game early or \nreplay it.\n\nThis repeatable loop reduces \nunnecessary navigation decisions and \nmakes moving between games feel \nnatural.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
                    {
                      "id": "Itvn2",
                      "type": "ref",
                      "ref": "s37h6",
                      "name": "frame-image",
                      "x": 0,
                      "y": 776,
                      "width": 343,
                      "height": 214.375,
                      "fill": [
                        "$background-secondary",
                        {
