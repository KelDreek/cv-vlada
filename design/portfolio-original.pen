                      "width": 343,
                      "height": 576,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "cnr5s",
                          "x": 0,
                          "y": 0,
                          "name": "Rebranding at Scale",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:392",
                            "sourcePath": "1:888/1:330/1:331/1:390/1:391/1:392"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 40,
                          "content": "Rebranding at Scale",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "bhFPL",
                          "x": 0,
                          "y": 72,
                          "name": "When the client decided to reposition the product, I took responsibility for updating its visual identity across a large, established application. Before starting the rebrand, I proposed four approaches ranging from a lightweight visual refresh to a more comprehensive UI redesign. Each option included visual examples, explanations of the proposed changes, and their scope and trade-offs. The client chose a lighter approach focused primarily on refreshing the visual language rather than rebuilding the entire interface.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:393",
                            "sourcePath": "1:888/1:330/1:331/1:390/1:391/1:393"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 504,
                          "content": "When the client decided to reposition \nthe product, I took responsibility for \nupdating its visual identity across a \nlarge, established application.\n\nBefore starting the rebrand, I proposed \nfour approaches ranging from a \nlightweight visual refresh to a more \ncomprehensive UI redesign.\n\nEach option included visual examples, \nexplanations of the proposed changes, \nand their scope and trade-offs.\n\nThe client chose a lighter approach \nfocused primarily on refreshing the \nvisual language rather than rebuilding \nthe entire interface.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "MoLDp",
                      "x": 0,
