                        {
                          "type": "text",
                          "id": "BqQTE",
                          "x": 0,
                          "y": 60,
                          "name": "Zuzuzoo: Designing a playful learning experience for little explorers",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:678",
                            "sourcePath": "1:889/1:673/1:674/1:675/1:676/1:678"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 160,
                          "content": "Zuzuzoo: Designing a \nplayful learning \nexperience for little \nexplorers",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "vmNgr",
                          "x": 0,
                          "y": 252,
                          "name": "Zuzuzoo is an educational app for toddlers, featuring interactive animal games, sounds, and a playful encyclopedia. As the sole designer on a two-person team, I shaped the product from the ground up – from UX flows and visual identity to illustrations, animations, and final UI.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:679",
                            "sourcePath": "1:889/1:673/1:674/1:675/1:676/1:679"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 280,
                          "content": "Zuzuzoo is an educational app for \ntoddlers, featuring interactive animal \ngames, sounds, and a playful \nencyclopedia.\n\nAs the sole designer on a two-person \nteam, I shaped the product from the \nground up – from UX flows and visual \nidentity to illustrations, animations, \nand final UI.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
