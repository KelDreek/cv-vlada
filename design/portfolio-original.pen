                        {
                          "type": "text",
                          "id": "n7T1k",
                          "x": 0,
                          "y": 0,
                          "name": "Beyond the Mobile App",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:406",
                            "sourcePath": "1:888/1:330/1:331/1:404/1:405/1:406"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 80,
                          "content": "Beyond the Mobile \nApp",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "HfNYW",
                          "x": 0,
                          "y": 112,
                          "name": "As the sole designer on the project, my responsibilities extended beyond iOS and Android applications. I also supported several connected products and visual touchpoints, maintaining consistency while adapting interfaces to different platforms and purposes.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:407",
                            "sourcePath": "1:888/1:330/1:331/1:404/1:405/1:407"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 252,
                          "content": "As the sole designer on the project, my \nresponsibilities extended beyond iOS \nand Android applications.\n\nI also supported several connected \nproducts and visual touchpoints, \nmaintaining consistency while \nadapting interfaces to different \nplatforms and purposes.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "d6Ayl",
                      "x": 0,
                      "y": 444,
                      "name": "Frame 10",
                      "metadata": {
                        "type": "figma-import",
