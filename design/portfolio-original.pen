                          "x": 192,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:314",
                            "sourcePath": "1:888/1:216/1:217/1:304/1:313/1:314"
                          },
                          "width": 640,
                          "height": 372,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "GJ7jq",
                              "x": 0,
                              "y": 0,
                              "name": "Participating in Apple Entrepreneur Camp",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:315",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:313/1:314/1:315"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Participating in Apple Entrepreneur Camp",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "HYwQ0",
                              "x": 0,
                              "y": 64,
                              "name": "Another valuable experience was participating in Apple Entrepreneur Camp as part of the product team. Over approximately three months, we joined remote sessions with Apple representatives, presented our work, and received feedback and guidance. I contributed to preparing presentations and promotional materials and participated in the team's learning and feedback sessions. The program provided an opportunity to learn from Apple experts and bring new perspectives back into our work.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:316",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:313/1:314/1:316"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 308,
                              "content": "Another valuable experience was participating in Apple Entrepreneur \nCamp as part of the product team.\n\nOver approximately three months, we joined remote sessions with Apple \nrepresentatives, presented our work, and received feedback and guidance.\n\nI contributed to preparing presentations and promotional materials and \nparticipated in the team's learning and feedback sessions.\n\nThe program provided an opportunity to learn from Apple experts and \nbring new perspectives back into our work.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
