                      },
                      "width": 343,
                      "height": 908,
                      "layout": "none",
                      "children": [
                        {
                          "type": "text",
                          "id": "GhFZq",
                          "x": 0,
                          "y": 0,
                          "name": "Designing for children who can't read yet",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:698",
                            "sourcePath": "1:889/1:673/1:674/1:696/1:697/1:698"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 120,
                          "content": "Designing for \nchildren who can't \nread yet",
                          "lineHeight": 1,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 40,
                          "fontWeight": "700",
                          "letterSpacing": -2.4000000953674316,
                          "fontStyle": "italic"
                        },
                        {
                          "type": "text",
                          "id": "ujz80",
                          "x": 0,
                          "y": 152,
                          "name": "Designing for toddlers meant rethinking familiar UI patterns. Text labels, complex navigation, and small interactive elements weren't suitable for an audience still learning to read and navigate digital experiences. My early concepts followed more conventional app patterns, but through exploration and iteration, I gradually shifted toward a simpler, more playful approach. I replaced text-heavy interfaces with large illustrations, increased touch target sizes, simplified navigation, and introduced a brighter visual language. The goal was to make the experience understandable without requiring children to learn how to use the interface first. The goal was to make the experience understandable without requiring children to learn how to use the interface first.",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:699",
                            "sourcePath": "1:889/1:673/1:674/1:696/1:697/1:699"
                          },
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": 343,
                          "height": 756,
                          "content": "Designing for toddlers meant \nrethinking familiar UI patterns. Text \nlabels, complex navigation, and small \ninteractive elements weren't suitable \nfor an audience still learning to read \nand navigate digital experiences.\n\nMy early concepts followed more \nconventional app patterns, but through \nexploration and iteration, I gradually \nshifted toward a simpler, more playful \napproach.\n\nI replaced text-heavy interfaces with \nlarge illustrations, increased touch \ntarget sizes, simplified navigation, and \nintroduced a brighter visual language.\n\nThe goal was to make the experience \nunderstandable without requiring \nchildren to learn how to use the \ninterface first.\n\nThe goal was to make the experience \nunderstandable without requiring \nchildren to learn how to use the \ninterface first.",
                          "lineHeight": 1.399999976158142,
                          "fontFamily": "Averia Serif Libre",
                          "fontSize": 20,
                          "fontWeight": "300",
                          "letterSpacing": -0.4000000059604645
                        }
                      ]
                    },
