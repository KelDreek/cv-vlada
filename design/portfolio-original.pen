                      "children": [
                        {
                          "type": "frame",
                          "id": "DrcxA",
                          "x": 192,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:319",
                            "sourcePath": "1:888/1:216/1:217/1:304/1:318/1:319"
                          },
                          "width": 640,
                          "height": 484,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "Zwfx0",
                              "x": 0,
                              "y": 0,
                              "name": "Outcomes & Reflection",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:320",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:318/1:319/1:320"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Outcomes & Reflection",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "qQvpR",
                              "x": 0,
                              "y": 64,
                              "name": "Over four years, I supported numerous feature releases, a major product rebrand, and the expansion of the platform across mobile and web. As the sole UX/UI designer, I was responsible not only for creating new interfaces, but also for maintaining design consistency and supporting their implementation. One of my most meaningful contributions was introducing Design QA as a regular part of the team's workflow. This project taught me to think beyond individual features, plan for future changes, and adapt to evolving business and product requirements. It also strengthened my ability to collaborate across disciplines, communicate design decisions, and find practical compromises.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:321",
                                "sourcePath": "1:888/1:216/1:217/1:304/1:318/1:319/1:321"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 420,
                              "content": "Over four years, I supported numerous feature releases, a major product \nrebrand, and the expansion of the platform across mobile and web.\n\nAs the sole UX/UI designer, I was responsible not only for creating new \ninterfaces, but also for maintaining design consistency and supporting \ntheir implementation.\n\nOne of my most meaningful contributions was introducing Design QA as \na regular part of the team's workflow.\n\nThis project taught me to think beyond individual features, plan for \nfuture changes, and adapt to evolving business and product requirements.\n\nIt also strengthened my ability to collaborate across disciplines, \ncommunicate design decisions, and find practical compromises.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
                        {
                          "type": "frame",
