                    {
                      "type": "frame",
                      "id": "DbuU0",
                      "x": 0,
                      "y": 2660.75,
                      "name": "Frame 12",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:432",
                        "sourcePath": "1:888/1:330/1:331/1:418/1:432"
                      },
                      "width": 343,
                      "height": 1524,
                      "layout": "none",
                      "children": [
                        {
                          "type": "frame",
                          "id": "E8ZiWd",
                          "x": 0,
                          "y": 0,
                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:433",
                            "sourcePath": "1:888/1:330/1:331/1:418/1:432/1:433"
                          },
                          "width": 343,
                          "height": 764,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "SUhmc",
                              "x": 0,
                              "y": 0,
                              "name": "Outcomes & Reflection",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:434",
                                "sourcePath": "1:888/1:330/1:331/1:418/1:432/1:433/1:434"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 32,
                              "content": "Outcomes & Reflection",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "Sa74W",
                              "x": 0,
                              "y": 64,
                              "name": "Over four years, I supported numerous feature releases, a major product rebrand, and the expansion of the platform across mobile and web. As the sole UX/UI designer, I was responsible not only for creating new interfaces, but also for maintaining design consistency and supporting their implementation. One of my most meaningful contributions was introducing Design QA as a regular part of the team's workflow. This project taught me to think beyond individual features, plan for future changes, and adapt to evolving business and product requirements. It also strengthened my ability to collaborate across disciplines, communicate design decisions, and find practical compromises.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:435",
                                "sourcePath": "1:888/1:330/1:331/1:418/1:432/1:433/1:435"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 343,
                              "height": 700,
                              "content": "Over four years, I supported numerous \nfeature releases, a major product \nrebrand, and the expansion of the \nplatform across mobile and web.\n\nAs the sole UX/UI designer, I was \nresponsible not only for creating new \ninterfaces, but also for maintaining \ndesign consistency and supporting \ntheir implementation.\n\nOne of my most meaningful \ncontributions was introducing Design \nQA as a regular part of the team's \nworkflow.\n\nThis project taught me to think beyond \nindividual features, plan for future \nchanges, and adapt to evolving \nbusiness and product requirements.\n\nIt also strengthened my ability to \ncollaborate across disciplines, \ncommunicate design decisions, and \nfind practical compromises.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "Hj9ZT",
