                          "name": "bio",
                          "metadata": {
                            "type": "figma-import",
                            "nodeId": "1:267",
                            "sourcePath": "1:888/1:216/1:217/1:260/1:266/1:267"
                          },
                          "width": 640,
                          "height": 456,
                          "layout": "none",
                          "children": [
                            {
                              "type": "text",
                              "id": "I5uaD",
                              "x": 0,
                              "y": 0,
                              "name": "Making daily activity the new focus",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:268",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:266/1:267/1:268"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 32,
                              "content": "Making daily activity the new focus",
                              "lineHeight": 1,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 32,
                              "fontWeight": "700",
                              "letterSpacing": -2,
                              "fontStyle": "italic"
                            },
                            {
                              "type": "text",
                              "id": "oQLsF",
                              "x": 0,
                              "y": 64,
                              "name": "Step tracking became one of the app's primary features. I designed a new home screen displaying the user's daily step count, personal goal, and progress toward that goal. The feature used activity data from Apple Health and Health Connect, allowing users to follow their daily movement. I also worked on a social activity feature where users could add friends and see their step progress, creating opportunities for mutual encouragement. The main challenge was organizing these interconnected experiences into a clear home screen.",
                              "metadata": {
                                "type": "figma-import",
                                "nodeId": "1:269",
                                "sourcePath": "1:888/1:216/1:217/1:260/1:266/1:267/1:269"
                              },
                              "fill": "$text-primary",
                              "textGrowth": "fixed-width-height",
                              "width": 640,
                              "height": 392,
                              "content": "Step tracking became one of the app's primary features.\n\nI designed a new home screen displaying the user's daily step count, \npersonal goal, and progress toward that goal.\n\nThe feature used activity data from Apple Health and Health Connect, \nallowing users to follow their daily movement.\n\nI also worked on a social activity feature where users could add friends \nand see their step progress, creating opportunities for mutual \nencouragement.\n\nThe main challenge was organizing these interconnected experiences into \na clear home screen.",
                              "lineHeight": 1.399999976158142,
                              "fontFamily": "Averia Serif Libre",
                              "fontSize": 20,
                              "fontWeight": "300",
                              "letterSpacing": -0.4000000059604645
                            }
                          ]
                        },
