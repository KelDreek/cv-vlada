                              "url": "original-assets/c1adcd75c07fb7c45b7155beb2726a28b8f94877.png",
                              "mode": "cover"
                            }
                          ],
                          "cornerRadius": 16,
                          "layout": "none",
                          "clip": true
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "gNCXh",
                      "x": 0,
                      "y": 1712,
                      "name": "Frame 11",
                      "metadata": {
                        "type": "figma-import",
