                          "cornerRadius": 16,
                          "layout": "none",
                          "clip": true
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "vHg8D",
                      "x": 0,
                      "y": 1746.375,
                      "name": "Frame 11",
                      "metadata": {
                        "type": "figma-import",
                        "nodeId": "1:427",
